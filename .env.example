GITHUB_TOKEN=""
GITHUB_API_BASE="https://api.github.com"
SCRAPER_POLL_MS="2000"
SCRAPER_MAX_CONCURRENT_JOBS="1"
SCRAPER_PAGE_SIZE="30"
SCRAPER_MAX_PAGES="10"
